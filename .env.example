# --- server ---
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# --- admin ---
# If empty, a random password is generated on first boot and printed once.
ADMIN_PASSWORD=
# Cookies are signed with this. If empty, a random one is stored in DATA_DIR.
SESSION_SECRET=

# --- gateway API keys (OpenAI style) ---
# Comma separated. If empty, a key is generated into DATA_DIR/api-keys.json.
GATEWAY_API_KEYS=

# --- secrets at rest ---
# 32-byte hex. If empty, a key file is generated in DATA_DIR.
# On a PaaS without a persistent disk, ALL credentials are lost on redeploy.
ENCRYPTION_KEY=

# --- upstream ---
UPSTREAM_BASE=https://cloudcode-pa.googleapis.com
DAILY_UPSTREAM_BASE=https://daily-cloudcode-pa.googleapis.com
UPSTREAM_API_VERSION=v1internal
USER_AGENT=antigravity/hub/2.33.0 (aidev_client; os_type=darwin; arch=arm64; cl=1023160026)

# --- robin (gpsoauth) identity used to mint a bearer from the master token ---
ROBIN_APP=com.google.android.gms
ROBIN_CLIENT_SIG=38918a453d07199354f8b19af05ec6562ced5788
ROBIN_SCOPES=https://www.googleapis.com/auth/cloud-platform https://www.googleapis.com/auth/aicode https://www.googleapis.com/auth/cclog https://www.googleapis.com/auth/experimentsandconfigs https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# --- AI Studio channel (studio-*) ---
# WAA signer binary; the container image ships it at /usr/local/bin/waa-signer.
WAA_SIGNER_PATH=
# WAA_DISABLED=1 turns the AI Studio channel off.
# AI_STUDIO_TIER=TIER1 is the default G1 tier header when a credential has no
# detected tier (Pro=TIER1, Ultra=TIER2, Plus=TIER0, Free=empty).
# WAA_PROXY= sends the signer through an HTTP proxy (usually not needed).

# --- behavior ---
REQUEST_TIMEOUT_MS=180000
CREDENTIAL_COOLDOWN_MS=30000
MAX_RETRIES=3
LOG_REQUESTS=false

# --- optional: Cloudflare KV persistence (survives restarts without a disk) ---
# Create a KV namespace + an API token with "Workers KV Storage: Edit".
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_KV_API_TOKEN=
# KV_STATS_FLUSH_MS=300000

# 代理池：自动测速选最快节点（默认开启，每 10 分钟一次）
# AUTO_FASTEST=0
# AUTO_FASTEST_MS=600000
